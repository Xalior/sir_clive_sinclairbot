{
  "name": "sir_clive_sinclairbot",
  "version": "0.1.0",
  "description": "A Discord channel-manager app",
  "main": "src/bot.ts",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "tsc --noEmit",
    "test": "wdio run ./wdio.conf.ts",
    "dev": "tsx watch --watch='src/**/*.ts' src/bot.ts",
    "start": "tsx src/bot.ts",
    "clean": "rm -rf dist/*",
    "wdio": "wdio run ./wdio.conf.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xalior/sir_clive_sinclairbot.git"
  },
  "keywords": [
    "discord",
    "bot",
    "spectrum",
    "next",
    "message",
    "gateway"
  ],
  "author": "D. Rimron-Soutter <darran@xalior.com>",
  "license": "AGPL-3.0",
  "bugs": {
    "url": "https://github.com/Xalior/sir_clive_sinclairbot/issues"
  },
  "homepage": "https://github.com/Xalior/sir_clive_sinclairbot#readme",
  "packageManager": "pnpm@10.18.1",
  "pnpm": {
    "overrides": {
      "undici@<6.27.0": ">=6.27.0 <7"
    }
  },
  "dependencies": {
    "@dr.pogodin/csurf": "^1.17.1",
    "@t3-oss/env-core": "^0.12.0",
    "@t3-oss/env-nextjs": "^0.12.0",
    "@types/node": "^22.20.1",
    "connect-flash": "^0.1.1",
    "connect-redis": "^8.1.0",
    "cookie-parser": "^1.4.7",
    "discord-api-types": "^0.37.120",
    "discord.js": "^14.26.4",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "express-session": "^1.19.0",
    "ioredis": "^5.11.1",
    "mustache-express": "^1.3.2",
    "nan": "^2.28.0",
    "openai": "^4.104.0",
    "openid-client": "^6.8.4",
    "passport": "^0.7.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.0",
    "typescript": "^5.9.3",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/connect-flash": "^0.0.40",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/mustache-express": "^1.2.5",
    "@types/passport": "^1.0.17",
    "@wdio/cli": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "@wdio/mocha-framework": "^9.29.1",
    "@wdio/spec-reporter": "^9.29.1",
    "express-list-endpoints": "^7.1.1",
    "wdio-wait-for": "^3.1.1"
  }
}
